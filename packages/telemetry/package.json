{
  "name": "@spiderbyte/telemetry",
  "version": "0.1.1",
  "private": false,
  "description": "Shared telemetry infrastructure for SpiderByte",
  "license": "MIT",
  "author": "SpiderByte contributors",
  "homepage": "https://github.com/SpiderByte/spiderbyte/tree/main/packages/telemetry#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpiderByte/spiderbyte.git",
    "directory": "packages/telemetry"
  },
  "bugs": {
    "url": "https://github.com/SpiderByte/spiderbyte/issues"
  },
  "keywords": [
    "spiderbyte",
    "telemetry",
    "analytics",
    "events",
    "client"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      }
    }
  }
}

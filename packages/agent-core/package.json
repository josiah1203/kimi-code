{
  "name": "@spiderbyte/agent-core",
  "version": "0.3.1",
  "private": false,
  "description": "SpiderByte Agent Core — DI × Scope runtime",
  "license": "MIT",
  "author": "SpiderByte contributors",
  "homepage": "https://github.com/SpiderByte/spiderbyte/tree/main/packages/agent-core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpiderByte/spiderbyte.git",
    "directory": "packages/agent-core"
  },
  "bugs": {
    "url": "https://github.com/SpiderByte/spiderbyte/issues"
  },
  "keywords": [
    "spiderbyte",
    "agent",
    "ai",
    "llm",
    "session",
    "tools"
  ],
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": {
      "types": "./package.json",
      "default": "./package.json"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen:contract-types": "node scripts/gen-contract-types.mjs",
    "gen:config-manifest": "tsx --import ../../build/register-raw-text-loader.mjs scripts/gen-config-manifest.mts",
    "gen:wire-manifest": "tsx --import ../../build/register-raw-text-loader.mjs scripts/gen-wire-manifest.mts",
    "gen:state-manifest": "tsx scripts/gen-state-manifest.mts",
    "lint:imports": "node scripts/check-import-boundaries.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@antfu/utils": "^9.3.0",
    "@anthropic-ai/sdk": "^0.95.2",
    "@google/genai": "^1.49.0",
    "@jsquash/webp": "^1.5.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.6.0",
    "@spiderbyte/minidb": "workspace:^",
    "@spiderbyte/oauth": "workspace:^",
    "@spiderbyte/protocol": "workspace:^",
    "@spiderbyte/tree-sitter-bash": "workspace:^",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "chokidar": "^4.0.3",
    "ignore": "^5.3.2",
    "jimp": "^1.6.1",
    "js-yaml": "^4.3.1",
    "linkedom": "^0.18.12",
    "node-pty": "^1.1.0",
    "openai": "^6.34.0",
    "pathe": "^2.0.3",
    "picomatch": "^4.0.4",
    "retry": "0.13.1",
    "smol-toml": "^1.6.1",
    "socks": "^2.8.9",
    "tar": "^7.5.19",
    "ulid": "^3.0.1",
    "undici": "^7.29.0",
    "yauzl": "^3.3.0",
    "yazl": "^3.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/picomatch": "^4.0.3",
    "@types/retry": "0.12.0",
    "@types/sinon": "^21.0.1",
    "@types/tar": "^7.0.87",
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^2.4.6",
    "sinon": "^22.0.0",
    "ts-morph": "^28.0.0",
    "tsx": "^4.21.0"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./package.json": "./package.json",
      "./*": {
        "types": "./src/*.ts"
      }
    }
  }
}

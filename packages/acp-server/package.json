{
  "name": "@spiderbyte/acp-server",
  "version": "0.0.0",
  "private": false,
  "description": "Agent Client Protocol (ACP) host backed directly by the DI × Scope agent engine (SpiderByte Agent Core)",
  "license": "MIT",
  "author": "SpiderByte contributors",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "@spiderbyte/agent-core": "workspace:^",
    "@spiderbyte/client": "workspace:^",
    "@spiderbyte/protocol": "workspace:^"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpiderByte/spiderbyte.git",
    "directory": "packages/acp-server"
  },
  "homepage": "https://github.com/SpiderByte/spiderbyte/tree/main/packages/acp-server#readme",
  "bugs": {
    "url": "https://github.com/SpiderByte/spiderbyte/issues"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      }
    }
  }
}

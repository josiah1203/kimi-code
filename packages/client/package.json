{
  "name": "@spiderbyte/client",
  "version": "0.1.1",
  "private": false,
  "description": "SpiderByte client SDK — contract-driven facade over SpiderByte Agent Core, routable over ipc or in-memory transports.",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./ipc": {
      "types": "./src/transports/ipc/index.ts",
      "default": "./src/transports/ipc/index.ts"
    },
    "./memory": {
      "types": "./src/transports/memory/index.ts",
      "default": "./src/transports/memory/index.ts"
    },
    "./browser": {
      "types": "./src/transports/browser.ts",
      "default": "./src/transports/browser.ts"
    },
    "./package.json": {
      "types": "./package.json",
      "default": "./package.json"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm typecheck:examples",
    "typecheck:examples": "tsc -p tsconfig.examples.json --noEmit",
    "test": "vitest run",
    "smoke": "tsx --tsconfig ./tsconfig.examples.json --import ../../build/register-raw-text-loader.mjs examples/smoke.ts",
    "smoke:boundary": "tsx --tsconfig ./tsconfig.examples.json --import ../../build/register-raw-text-loader.mjs examples/model-requester-boundary.ts",
    "smoke:select-tools": "tsx --tsconfig ./tsconfig.examples.json --import ../../build/register-raw-text-loader.mjs examples/spiderbyte-select-tools.ts",
    "stress:kosong-config": "tsx --tsconfig ./tsconfig.examples.json --import ../../build/register-raw-text-loader.mjs examples/kosong-config-stress.ts",
    "clean": "rm -rf dist",
    "docker:e2e": "bash scripts/run-docker-e2e.sh"
  },
  "dependencies": {
    "@spiderbyte/agent-core": "workspace:^",
    "@spiderbyte/protocol": "workspace:^",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/ws": "^8.18.0",
    "ulid": "^3.0.1",
    "ws": "^8.21.0"
  },
  "author": "SpiderByte contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpiderByte/spiderbyte.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/SpiderByte/spiderbyte/tree/main/packages/client#readme",
  "bugs": {
    "url": "https://github.com/SpiderByte/spiderbyte/issues"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./src/index.ts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./ipc": {
        "types": "./src/transports/ipc/index.ts",
        "import": "./dist/transports/ipc/index.mjs",
        "default": "./dist/transports/ipc/index.mjs"
      },
      "./memory": {
        "types": "./src/transports/memory/index.ts",
        "import": "./dist/transports/memory/index.mjs",
        "default": "./dist/transports/memory/index.mjs"
      },
      "./browser": {
        "types": "./src/transports/browser.ts",
        "import": "./dist/transports/browser.mjs",
        "default": "./dist/transports/browser.mjs"
      },
      "./package.json": "./package.json"
    }
  }
}

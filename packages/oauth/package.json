{
  "name": "@spiderbyte/oauth",
  "version": "0.3.0",
  "private": false,
  "description": "Provider-neutral OAuth and local credential toolkit",
  "license": "MIT",
  "author": "SpiderByte contributors",
  "homepage": "https://github.com/SpiderByte/spiderbyte/tree/main/packages/oauth#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpiderByte/spiderbyte.git",
    "directory": "packages/oauth"
  },
  "bugs": {
    "url": "https://github.com/SpiderByte/spiderbyte/issues"
  },
  "keywords": [
    "spiderbyte",
    "oauth",
    "authentication",
    "auth",
    "cli"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "proper-lockfile": "^4.1.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/proper-lockfile": "^4.1.4"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      }
    }
  }
}

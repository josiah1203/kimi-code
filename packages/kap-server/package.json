{
  "name": "@spiderbyte/kap-server",
  "version": "0.2.1",
  "private": false,
  "description": "SpiderByte server backed by the DI × Scope agent engine (SpiderByte Agent Core)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./contract": {
      "types": "./src/contract.ts",
      "default": "./src/contract.ts"
    },
    "./search-worker-runtime": {
      "types": "./src/search/worker/runtime.ts",
      "default": "./src/search/worker/runtime.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@fastify/multipart": "^10.0.0",
    "@fastify/swagger": "^9.7.0",
    "@spiderbyte/agent-core": "workspace:^",
    "@spiderbyte/minidb": "workspace:^",
    "@spiderbyte/oauth": "workspace:^",
    "@spiderbyte/protocol": "workspace:^",
    "@spiderbyte/transcript": "workspace:^",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.1.0",
    "pino": "^9.5.0",
    "smol-toml": "^1.6.1",
    "ulid": "^3.0.1",
    "ws": "^8.18.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/ws": "^8.18.0",
    "tsx": "^4.21.0"
  },
  "license": "MIT",
  "author": "SpiderByte contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpiderByte/spiderbyte.git",
    "directory": "packages/kap-server"
  },
  "homepage": "https://github.com/SpiderByte/spiderbyte/tree/main/packages/kap-server#readme",
  "bugs": {
    "url": "https://github.com/SpiderByte/spiderbyte/issues"
  },
  "files": [
    "dist"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./contract": {
        "types": "./dist/contract.d.mts",
        "import": "./dist/contract.mjs",
        "default": "./dist/contract.mjs"
      },
      "./search-worker-runtime": {
        "types": "./dist/search-worker-runtime.d.mts",
        "import": "./dist/search-worker-runtime.mjs",
        "default": "./dist/search-worker-runtime.mjs"
      }
    }
  }
}

{
  "name": "@spiderbyte/protocol",
  "version": "0.5.0",
  "private": false,
  "description": "Shared REST + WS protocol schemas (envelope, error codes, pagination, ws-control) for the SpiderByte daemon.",
  "license": "MIT",
  "author": "SpiderByte contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpiderByte/spiderbyte.git",
    "directory": "packages/protocol"
  },
  "bugs": {
    "url": "https://github.com/SpiderByte/spiderbyte/issues"
  },
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "ulid": "^3.0.1",
    "zod": "^4.3.6"
  },
  "homepage": "https://github.com/SpiderByte/spiderbyte/tree/main/packages/protocol#readme",
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      }
    }
  }
}

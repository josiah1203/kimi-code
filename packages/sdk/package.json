{
  "name": "@spiderbyte/sdk",
  "version": "0.15.3",
  "private": false,
  "description": "TypeScript SDK for the SpiderByte Agent Core",
  "license": "MIT",
  "author": "SpiderByte contributors",
  "homepage": "https://github.com/SpiderByte/spiderbyte/tree/main/packages/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpiderByte/spiderbyte.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/SpiderByte/spiderbyte/issues"
  },
  "keywords": [
    "spiderbyte",
    "sdk",
    "typescript",
    "agent",
    "api"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown && pnpm run build:dts",
    "build:dts": "node scripts/build-dts.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist .tmp-api-extractor"
  },
  "dependencies": {
    "@antfu/utils": "^9.3.0",
    "@spiderbyte/agent-core": "workspace:^",
    "@spiderbyte/client": "workspace:^",
    "@spiderbyte/kaos": "workspace:^",
    "@spiderbyte/kosong": "workspace:^",
    "@spiderbyte/oauth": "workspace:^",
    "@spiderbyte/protocol": "workspace:^",
    "smol-toml": "^1.6.1",
    "yazl": "^3.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/yazl": "^2.4.6",
    "jimp": "^1.6.1"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts"
}

{
  "name": "@spiderbyte/kaos",
  "version": "0.1.6",
  "private": false,
  "description": "Execution environment abstraction for AI agent applications",
  "license": "MIT",
  "author": "SpiderByte contributors",
  "homepage": "https://github.com/SpiderByte/spiderbyte/tree/main/packages/kaos#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpiderByte/spiderbyte.git",
    "directory": "packages/kaos"
  },
  "bugs": {
    "url": "https://github.com/SpiderByte/spiderbyte/issues"
  },
  "keywords": [
    "spiderbyte",
    "agent",
    "execution",
    "sandbox",
    "process",
    "filesystem"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./ssh": {
      "types": "./src/ssh.ts",
      "default": "./src/ssh.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "pathe": "^2.0.3",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/ssh2": "^1.15.5"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./ssh": {
        "types": "./dist/ssh.d.mts",
        "import": "./dist/ssh.mjs",
        "default": "./dist/ssh.mjs"
      }
    }
  }
}

{
  "name": "@spiderbyte/minidb",
  "version": "0.2.0",
  "private": false,
  "description": "A pure-Node.js embedded key-value database mixing Redis-style in-memory KV with SQLite-style durable persistence (WAL + snapshot).",
  "license": "MIT",
  "author": "SpiderByte contributors",
  "homepage": "https://github.com/SpiderByte/spiderbyte/tree/main/packages/minidb#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpiderByte/spiderbyte.git",
    "directory": "packages/minidb"
  },
  "bugs": {
    "url": "https://github.com/SpiderByte/spiderbyte/issues"
  },
  "keywords": [
    "spiderbyte",
    "database",
    "key-value",
    "embedded",
    "wal",
    "snapshot"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./cluster": {
      "types": "./dist/cluster/index.d.mts",
      "import": "./dist/cluster/index.mjs",
      "default": "./dist/cluster/index.mjs"
    },
    "./worker-runtime": {
      "types": "./dist/worker-runtime.d.mts",
      "import": "./dist/worker-runtime.mjs",
      "default": "./dist/worker-runtime.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "bench": "node --import tsx bench/bench.ts",
    "bench:cluster": "node --import tsx bench/cluster.ts",
    "bench:open": "node --import tsx bench/open-lifecycle.ts",
    "clean": "rm -rf dist"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./cluster": {
        "types": "./dist/cluster/index.d.mts",
        "import": "./dist/cluster/index.mjs",
        "default": "./dist/cluster/index.mjs"
      },
      "./worker-runtime": {
        "types": "./dist/worker-runtime.d.mts",
        "import": "./dist/worker-runtime.mjs",
        "default": "./dist/worker-runtime.mjs"
      }
    }
  }
}

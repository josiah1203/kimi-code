NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=YOUR_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=YOUR_CLERK_SECRET_KEY

# Server-only URL for the authorized SpiderByte REST API. The Next.js BFF
# forwards only the browser-safe workspaces, sessions, organizations, and
# projects routes (including collaboration routes nested under workspaces).
SPIDERBYTE_API_URL=http://127.0.0.1:8000
# Server-only daemon/commercial bearer credential. Never expose this as
# NEXT_PUBLIC_* or accept it from browser input.
SPIDERBYTE_API_TOKEN=YOUR_SPIDERBYTE_SERVER_TOKEN

# Optional shared secret for the server-to-server Clerk → SpiderByte identity
# assertion. Set the same 32+ character secret on kap-server as
# SPIDERBYTE_IDENTITY_BRIDGE_SECRET. Hosted deployments should set the require
# flag to 1; local accountless deployments may leave both unset.
SPIDERBYTE_IDENTITY_BRIDGE_SECRET=YOUR_IDENTITY_BRIDGE_SECRET_AT_LEAST_32_CHARS
SPIDERBYTE_REQUIRE_IDENTITY_BRIDGE=0

# Optional direct WebSocket endpoint. Leave unset to use transcript/platform
# REST catch-up polling; Next.js Route Handlers do not proxy WebSocket upgrades.
# When set, the browser obtains a short-lived identity subprotocol from the
# same-origin BFF; it does not send a Clerk JWT or SpiderByte server token.
NEXT_PUBLIC_SPIDERBYTE_WS_URL=

# Optional server-only commercial endpoint. The web BFF forwards a verified
# Clerk session token to the hosted route; it never exposes server credentials.
SPIDERBYTE_COMMERCIAL_API_URL=
# Set to 1 in hosted mode so every BFF platform request first performs the
# server-side Clerk membership synchronization check.
SPIDERBYTE_REQUIRE_COMMERCIAL_SESSION_SYNC=0

# Optional UI defaults. IDs are accepted only after the server returns them
# for the signed-in principal; they are not authorization inputs.
NEXT_PUBLIC_SPIDERBYTE_WORKSPACE_ID=
NEXT_PUBLIC_SPIDERBYTE_SESSION_ID=

{
  "name": "@spiderbyte/commercial-admin",
  "version": "0.1.0",
  "private": true,
  "description": "SpiderByte Team and Business organization administration contracts",
  "license": "MIT",
  "type": "module",
  "imports": { "#/*": "./src/*.ts" },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",

{
  "name": "@spiderbyte/legacy-migration",
  "version": "0.1.16",
  "description": "Migrate kimi-cli (~/.kimi/) data into kimi-code (~/.kimi-code/).",
  "license": "MIT",
  "type": "module",
  "private": true,
  "files": [
    "dist"
  ],
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@spiderbyte/legacy-agent-core": "file:../legacy-agent-core",
    "smol-toml": "^1.6.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@spiderbyte/kaos": "workspace:^"
  }
}
